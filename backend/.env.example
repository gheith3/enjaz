# Local dev on ghaklab: Flock site https://injazat.test (preview: `demo injazat` -> https://demo.fahim.om).
# DB/Redis = Flock services; files = OneBox bucket injazat-demo (own bucket-scoped keys).
APP_NAME=injazat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://injazat.test

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=injazat
DB_USERNAME=injazat_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OneBox S3 (https://onebox.fahim.om). Keys for the injazat-demo bucket; never the root keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=injazat-demo
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://onebox.fahim.om
AWS_URL=https://onebox.fahim.om/injazat-demo

VITE_APP_NAME="${APP_NAME}"

# First admin (DatabaseSeeder). Local default: admin@example.com / password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Dev: no full-page cache (edits show at once); image conversions run during upload (no queue worker in dev).
RESPONSE_CACHE_ENABLED=false
QUEUE_CONVERSIONS_BY_DEFAULT=false
MEDIA_DISK=s3
