# LIVE settings. Copy to docker/.env.ghaklab (git-ignored, chmod 600) in ~/live/injazat and fill in.
# Generate secrets:  openssl rand -base64 24 | tr -d '/+='      APP_KEY:  echo "base64:$(openssl rand -base64 32)"

APP_NAME=injazat
APP_URL=https://injazat.fahim.om
APP_KEY=
APP_ENV=production
APP_DEBUG=false

POSTGRES_DB=injazat
POSTGRES_USER=injazat_user
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Host ports (127.0.0.1 only) - must be unique per project on ghaklab
DB_HOST_PORT=5790
REDIS_HOST_PORT=5791

# OneBox S3: LIVE bucket `injazat` + its own bucket-scoped keys (~/server/onebox/README.md)
S3_URL=https://onebox.fahim.om
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_BUCKET=injazat

# First start: seed (creates the admin), then set to true
RUN_MIGRATIONS=seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_MAILER=log
