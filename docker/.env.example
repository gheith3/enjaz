# Production settings for docker/docker-compose.prod.yml (Portainer stack environment, or a .env next to the file).
# Never commit real values. REQUIRED values are marked.

# Application
APP_NAME=injazat
APP_ENV=production
APP_DEBUG=false
# REQUIRED: public URL of the site (also ASSET_URL), no trailing slash
APP_URL=https://example.om
# REQUIRED: generate with  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
LOG_LEVEL=warning

# Image tag to run (default latest)
IMAGE_TAG=latest

# Database (PostgreSQL container)
POSTGRES_DB=injazat
POSTGRES_USER=injazat_user
# REQUIRED
POSTGRES_PASSWORD=

# Redis container (empty = no password; it is only on the internal network)
REDIS_PASSWORD=

# Sessions (e.g. .example.om to share across subdomains; empty = this host)
SESSION_DOMAIN=

# Mail for the contact form: MAIL_MAILER=smtp + the values below sends; "log" keeps messages in the dashboard inbox only
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="إنجازات شباب عُمان"

# Files: external S3 / RustFS
# REQUIRED
AWS_ACCESS_KEY_ID=
# REQUIRED
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# The bucket must exist, with public read on media/
AWS_BUCKET=enjaz
# REQUIRED: public URL of the S3 API (no trailing slash; the bucket is appended)
S3_URL=https://files.example.om
# Optional: how the app container reaches S3 server-side (e.g. http://rustfs:9000); empty = S3_URL
S3_ENDPOINT=

# AI assistant (MCP, docs/mcp.md)
ENJAZ_MCP_ENABLED=true
# Comma-separated IPs/CIDRs allowed to call /mcp; empty = any
ENJAZ_MCP_ALLOWED_IPS=
ENJAZ_MCP_PERSONAL_TOKENS=true
# OAuth signing keys (PEM). Empty = generated once into the storage volume; keep that volume (or set these) so
# assistants stay connected across releases.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
# Browser origins allowed to call /mcp besides claude.ai / claude.com (comma-separated); empty = defaults
MCP_ALLOWED_ORIGINS=

# Startup: true = migrate + sync site structure on every start (safe)
RUN_MIGRATIONS=true
# First super admin (the account with this email gets the super_admin role)
ADMIN_EMAIL=
