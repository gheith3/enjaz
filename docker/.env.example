# Production environment for docker-compose.prod.yml.
# Copy to .env next to the compose file and fill in the REQUIRED values:
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d
# Variables marked (default) can be left out; the compose file falls back to
# the value shown.

# ============================================
# Application
# ============================================
APP_NAME=Enjaz
APP_ENV=production
APP_DEBUG=false
# REQUIRED — public URL served by nginx (also used as ASSET_URL)
APP_URL=https://enjaz.example.com
# REQUIRED — generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ============================================
# Logging
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ============================================
# Database (PostgreSQL container)
# ============================================
POSTGRES_DB=enjaz
POSTGRES_USER=enjaz_user
# REQUIRED
POSTGRES_PASSWORD=

# ============================================
# Redis container
# ============================================
# Leave empty to run Redis without a password (it is only on the internal network)
REDIS_PASSWORD=

# ============================================
# Session & Broadcast
# ============================================
# e.g. .example.com to share the session across subdomains; empty = current host
SESSION_DOMAIN=
BROADCAST_CONNECTION=log

# ============================================
# Mail — set MAIL_MAILER=smtp to actually send email
# ============================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Enjaz"

# ============================================
# File storage (bundled RustFS S3 container)
# ============================================
# REQUIRED — also used as the RustFS root credentials. Use strong, unique values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Create this bucket once in the RustFS console before the first upload
AWS_BUCKET=enjaz
# REQUIRED — public URL nginx proxies to enjaz-s3:9000 (the S3 API, not the console).
# No trailing slash; the bucket name is appended automatically.
S3_URL=https://s3.enjaz.example.com
# Host ports published by the RustFS container
S3_API_PORT=5665
S3_CONSOLE_PORT=5664

# ============================================
# Backups
# ============================================
BACKUP_DISK=s3

# ============================================
# AI assistant (MCP) — see docs/MCP.md
# ============================================
# When false, /mcp answers 404
ENJAZ_MCP_ENABLED=false
# Comma-separated IPs/CIDRs allowed to call /mcp; empty = any
ENJAZ_MCP_ALLOWED_IPS=
ENJAZ_MCP_PERSONAL_TOKENS=true
# Leave DB_MCP_PASSWORD empty: setting it makes the entrypoint run
# cams:mcp-sql-setup, which this app does not have (it only logs a warning).
DB_MCP_USERNAME=enjaz_mcp_reader
DB_MCP_PASSWORD=

# ============================================
# Startup
# ============================================
RUN_MIGRATIONS=true
